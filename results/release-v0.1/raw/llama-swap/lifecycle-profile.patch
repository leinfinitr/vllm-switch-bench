 var ErrStartAborted = fmt.Errorf("aborted")
 
+var lifecycleProfileMu sync.Mutex
+
+type lifecycleProfileEvent struct {
+	Model       string  `json:"model"`
+	Phase       string  `json:"phase"`
+	StartedAt   string  `json:"started_at"`
+	EndedAt     string  `json:"ended_at"`
+	DurationSec float64 `json:"duration_s"`
+	Success     bool    `json:"success"`
+}
+
+func emitLifecycleProfile(model, phase string, started time.Time, success bool) {
+	path := os.Getenv("LLAMA_SWAP_LIFECYCLE_PROFILE_PATH")
+	if path == "" {
+		return
+	}
+	ended := time.Now()
+	payload, err := json.Marshal(lifecycleProfileEvent{
+		Model:       model,
+		Phase:       phase,
+		StartedAt:   started.UTC().Format(time.RFC3339Nano),
+		EndedAt:     ended.UTC().Format(time.RFC3339Nano),
+		DurationSec: ended.Sub(started).Seconds(),
+		Success:     success,
+	})
+	if err != nil {
+		return
+	}
+	lifecycleProfileMu.Lock()
+	defer lifecycleProfileMu.Unlock()
+	file, err := os.OpenFile(path, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o644)
+	if err != nil {
+		return
+	}
+	defer file.Close()
+	_, _ = file.Write(append(payload, '\n'))
+}
